# Copy to .env.local for local development.
# Never commit real secrets.

# Required. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-at-least-32-character-secret"

# Public origin of this app (used for auth cookies and invite links)
BETTER_AUTH_URL="http://localhost:3000"

# Local default: file-backed PGlite (PostgreSQL-compatible, no Docker required)
PGLITE_DATA_DIR=".data/voxa"

# Optional. When unset, Avery will say the model is not configured.
# OPENAI_API_KEY=""
# VOXA_MODEL_API_KEY=""
# VOXA_MODEL="gpt-4o-mini"
# Explicit test adapter (not a production model):
# VOXA_MODEL_ADAPTER="test"

# Web research (Tavily). Server-side only. Leave unset to keep research disconnected.
# TAVILY_API_KEY=""
# VOXA_RESEARCH_API_KEY=""
# Explicit test/fixture adapter (never a live provider):
# VOXA_RESEARCH_ADAPTER="test"

# Durable work execution. Default is Inngest (`work/execute.run`).
# Local Inngest Dev Server requires:
# INNGEST_DEV=1
# Then run: npx inngest-cli@latest dev -u http://localhost:3000/api/inngest
# Use "inline" only for tests or emergency local debugging — it is not browser-independent.
# VOXA_WORK_EXECUTOR="inngest"
# INNGEST_EVENT_KEY=""
# INNGEST_SIGNING_KEY=""
